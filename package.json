{
  "name": "genealogy-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:migrate": "node --experimental-strip-types scripts/db-migrate.ts",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:check": "node --experimental-strip-types scripts/db-check.ts",
    "db:verify": "node --experimental-strip-types scripts/db-verify.ts",
    "db:status": "node --experimental-strip-types scripts/db-status.ts",
    "db:reset": "node --experimental-strip-types scripts/db-reset.ts",
    "backup": "node --experimental-strip-types scripts/backup.ts",
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --watch --experimental-strip-types server/src/main.ts",
    "start:server": "node --experimental-strip-types server/src/main.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "preview:web": "vite preview --config web/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:server && npm run test:web",
    "test:server": "vitest run --config vitest.config.ts",
    "test:web": "vitest run --config web/vitest.config.ts"
  },
  "prisma": {
    "schema": "server/prisma/schema.prisma"
  },
  "dependencies": {
    "@ant-design/icons": "^5.6.1",
    "@prisma/client": "^6.0.0",
    "@tanstack/react-query": "^5.104.5",
    "antd": "^5.29.3",
    "axios": "^1.20.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "dayjs": "^1.11.23",
    "express": "^4.22.3",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pino": "^9.14.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^4.7.0",
    "axios-mock-adapter": "^2.1.0",
    "concurrently": "^10.0.6",
    "jsdom": "^30.1.3",
    "prisma": "^6.0.0",
    "supertest": "^7.3.1",
    "typescript": "^5.0.0",
    "vite": "^6.4.5",
    "vitest": "^3.0.0"
  }
}
